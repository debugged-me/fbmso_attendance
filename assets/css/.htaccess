# Every page references these files with ?v=<mtime><size>, added by
# application/libraries/Page_finish.php, so a changed file always gets a new
# URL. That makes it safe to cache them outright instead of re-checking each
# one on every page view (24 round trips per page on a phone).
# A file loaded some other way than through a rendered page would keep its
# old copy for a year — give it a ?v= by hand if that ever happens.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header unset Pragma
    Header unset Expires
  </FilesMatch>
</IfModule>
