# Nothing under application/ is ever served over HTTP.
# CodeIgniter loads these files from disk; the web server must not reach them.
# Without this, application/views/*.php renders directly from the URL bar.

Options -Indexes -MultiViews

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
